# ============================================================================
# GEMSIM PLATFORM: ENVIRONMENT CONFIGURATION (.env)
# ============================================================================

# Server Configuration
NODE_ENV=production
PORT=8089
HOST=0.0.0.0

# Persistent Database Storage
DATA_DIR=./server/data
DB_PATH=./server/data/gemsim.db

# ----------------------------------------------------------------------------
# AI Engine Configuration ("Bring Your Own AI / Key")
# Supported values: fallback | ollama | gemini | claude | openai
# ----------------------------------------------------------------------------
DEFAULT_AI_PROVIDER=fallback

# 1. Local Ollama Configuration (Rootless Podman Bridge or Localhost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b

# 2. Google Gemini API (BYOK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. Anthropic Claude API (BYOK)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 4. OpenAI API (BYOK)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 4b. Any OpenAI-compatible API for System 2 (Mistral, Groq, OpenRouter, LM Studio...)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# 5. System One: the judgments (verdicts, trust shifts, board votes, Studio checks),
# configured apart from System 2 above. ollama | gemini | claude | openai | custom.
# On Ollama, a model with the "decision" capability (Clef) is called natively (one forward
# pass); any other model emulates it with JSON probabilities (slower, for comparison).
# Also editable in Settings > System 1.
SYSTEMONE_ENABLED=true
SYSTEMONE_PROVIDER=ollama
SYSTEMONE_BASE_URL=http://localhost:11434
SYSTEMONE_MODEL=clef-flash
# Key for gemini, claude, openai or custom
SYSTEMONE_API_KEY=
SYSTEMONE_TIMEOUT_MS=20000
# true = sample verdicts from the probability distribution (less predictable NPCs)
SYSTEMONE_STOCHASTIC=false

# LLM timeouts. Local Ollama calls never go below OLLAMA_MIN_TIMEOUT_MS because a
# model may need to load first (e.g. when Clef-flash and the dialogue model cannot
# both stay in memory and Ollama swaps them).
AI_CHAT_TIMEOUT_MS=45000
AI_STUDIO_TIMEOUT_MS=300000
OLLAMA_MIN_TIMEOUT_MS=120000

# ----------------------------------------------------------------------------
# Optional infrastructure
# ----------------------------------------------------------------------------
# PostgreSQL becomes the system of record (run `npx prisma db push` in server/ first)
# DATABASE_URL=postgresql://gemsim:gemsim@localhost:5432/gemsim
# Redis enables BullMQ round resolution jobs
# REDIS_URL=redis://127.0.0.1:6379

# ----------------------------------------------------------------------------
# Workshop Facilitator Access Control
# ----------------------------------------------------------------------------
# Master passcode required to access or unlock Facilitator War Room & Operations Cockpit
FACILITATOR_PIN=1337

